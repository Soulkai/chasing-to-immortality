# PostgreSQL local. Use docker-compose.yml para subir rápido.
DATABASE_URL="postgresql://wuxia:wuxia@localhost:5432/wuxia_game?schema=public"

# Login por número: sem +, parênteses, espaços ou traços. Exemplo: 5567999999999
# Se ficar vazio, o bot mostra QR no terminal.
LOGIN_PHONE_NUMBER="556798155863"

# Donos globais do bot. Mantive os dois formatos que você pediu.
ADMIN_NUMBERS="5567981445060,5567814459060"

# Prefixo principal dos comandos.
BOT_PREFIX="!"

# Se true, em grupos o bot só responde depois de !ativarbot por admin.
REQUIRE_GROUP_ACTIVATION="true"

# Nome da sessão Baileys salva localmente.
AUTH_DIR="auth"

# Ativar logs mais detalhados.
LOG_LEVEL="info"
