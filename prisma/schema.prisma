generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  whatsappId        String   @unique
  displayName       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  characters        Character[]
  registrationFlows RegistrationFlow[]
  prompts           InteractivePrompt[]
  legacies          Legacy[]
}

model BotGroupActivation {
  id            String   @id @default(cuid())
  chatJid       String   @unique
  activatedBy   String
  activatedAt   DateTime @default(now())
  isActive      Boolean  @default(true)
}

model RegistrationFlow {
  id              String   @id @default(cuid())
  userId          String
  chatJid         String
  name            String
  sex             String
  rerollsUsed     Int      @default(0)
  step            String   @default("ROLL_CONFIRM")
  currentRoll     Json
  moralityAnswers Json     @default("[]")
  isFinished      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InteractivePrompt {
  id             String    @id @default(cuid())
  userId         String
  chatJid        String
  messageId      String    @unique
  promptType     String
  payload        Json
  status         String    @default("ACTIVE")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  answeredAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Character {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  sex                String
  active             Boolean  @default(true)
  isFinalDead        Boolean  @default(false)

  raceName           String
  clanName           String
  talentName         String
  talentLevel        Int
  destinyName        String
  destinyLevel       Int
  luckName           String
  luckLevel          Int
  karmaValue         Int      @default(0)
  karmaTitle         String   @default("Neutro")
  spiritualRootName  String
  divineBodyName     String
  regionName         String
  sectName           String   @default("Nenhuma")
  appearanceUrl      String?

  bodyRealm          String   @default("Corpo Mortal")
  bodyStage          Int      @default(1)
  spiritRealm        String   @default("Condensação de Qi")
  spiritStage        Int      @default(1)
  soulRealm          String   @default("Alma Adormecida")
  soulStage          Int      @default(1)

  hp                 Int
  maxHp              Int
  qi                 Int
  maxQi              Int
  soulPower          Int
  maxSoulPower       Int

  lives              Int      @default(9)
  maxLives           Int      @default(9)

  strength           Int
  constitution       Int
  agility            Int
  intelligence       Int
  perception         Int
  spirit             Int
  willpower          Int
  charisma           Int
  luckAttribute      Int

  cultivationPoints  Int      @default(0)
  spiritExp          Int      @default(0)
  bodyExp            Int      @default(0)
  soulExp            Int      @default(0)
  spiritRealmIndex   Int      @default(1)
  bodyRealmIndex     Int      @default(0)
  soulRealmIndex     Int      @default(0)

  deaths             Int      @default(0)
  bossesKilled       Int      @default(0)
  techniquesMastered Int      @default(0)
  foundedSect        Boolean  @default(false)
  wealthEarned       Int      @default(0)

  spiritStones       Int      @default(300)
  reputation         Int      @default(0)
  inventory          Json     @default("{}")
  knownTechniques    Json     @default("[]")
  equippedTechnique  String?  @default("Punho Mortal")
  activeMission      Json?
  activeCombat       Json?
  professionName     String?
  professionLevel    Int      @default(0)
  professionExp      Int      @default(0)
  sectRole           String?
  currentActivity    String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Legacy {
  id             String   @id @default(cuid())
  userId         String
  oldCharacterId String
  fatePoints     Int
  summary        Json
  spentPoints    Int      @default(0)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommandLog {
  id          String   @id @default(cuid())
  chatJid     String
  senderJid   String
  senderPhone String
  command     String
  rawText     String
  createdAt   DateTime @default(now())
}
